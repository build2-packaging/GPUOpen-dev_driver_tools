intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.
import intf_libs += libgpuopen-devdriverapi-headers%lib{gpuopen-devdriverapi-headers}
import impl_libs += librapidjson%lib{rapidjson}
import impl_libs += libmetrohash%lib{metrohash}

windows = ($cxx.target.class == 'windows')

if $windows
  import impl_libs += libgpuopen-adl%lib{gpuopen-adl}

dd = DevDriverComponents

lib{DevDriverAPI}: {hxx ixx}{** -tdh-libs}                               \
                   cxx{** -DevDriverAPI/ADLGetDriverVersion          \
                          -$dd/listener/transports/winPipeTransport \
                          -$dd/src/protocols/etw*                   \
                          -$dd/src/win/*                            \
                          -$dd/src/posix/*}

# Platform-specific sources, as in upstream.
#
lib{DevDriverAPI}: cxx{DevDriverAPI/ADLGetDriverVersion          \
                       $dd/listener/transports/winPipeTransport \
                       $dd/src/protocols/etw*                   \
                       $dd/src/win/*}: include = $windows

lib{DevDriverAPI}: hxx{tdh-libs}: include = $windows

lib{DevDriverAPI}: cxx{$dd/src/posix/*}: include = (!$windows)

lib{DevDriverAPI}: $impl_libs $intf_libs

# Build options.
#
out_pfx = [dir_path] $out_root/source/
src_pfx = [dir_path] $src_root/source/

cxx.poptions =+ "-I$out_pfx" "-I$src_pfx"

# Header search paths, as in upstream. Note that $dd/src/imported/ contains
# the shim that redirects the bundled MetroHash header to the packaged one.
#
cxx.poptions += "-I$src_pfx/$dd/inc" \
                "-I$src_pfx/$dd/src/imported/metrohash/src"

if $windows
  cxx.poptions += "-I$src_pfx/$dd/listener"
else
  cxx.poptions += -D_LINUX

cxx.poptions += -DGPUOPEN_CLIENT_INTERFACE_MAJOR_VERSION=35

objs{*}: cxx.poptions += -DBUILD_DLL

if $windows
  cxx.libs += advapi32.lib ole32.lib ws2_32.lib
else
  cxx.libs += -pthread

# Pull in tdh.lib with #pragma comment so it does not go through the
# installed .pc (https://github.com/build2/build2/issues/557).
#
if ($cxx.target.system == 'win32-msvc')
{
  if ($cxx.class == 'gcc')
    cxx.poptions += -include "$src_pfx/tdh-libs.h"
  else
    cxx.poptions += "/FI$src_pfx/tdh-libs.h"
}

# Silence warnings about the upstream sources: nameless structs and unions
# (disabled in upstream for MSVC, and GCC has no narrower option for these
# than -Wno-pedantic), unused variables (disabled in upstream for GCC), the
# std::is_pod type trait (deprecated in C++20), the Clang
# __has_trivial_destructor() builtin (deprecated in favor of
# __is_trivially_destructible()), and, on Windows, the noreturn assert
# handler that returns if hard asserts are disabled.
#
switch $cxx.id
{
  case 'msvc'
    cxx.coptions += /wd4201

  case 'gcc'
    cxx.coptions += -Wno-pedantic -Wno-unused-variable \
                    -Wno-deprecated-declarations

  case 'clang' | 'msvc-clang'
  {
    cxx.coptions += -Wno-gnu-anonymous-struct -Wno-nested-anon-types \
                    -Wno-deprecated-declarations -Wno-deprecated-builtins

    if $windows
      cxx.coptions += -Wno-invalid-noreturn
  }
}

# Export options.
#
lib{DevDriverAPI}:
{
  cxx.export.libs = $intf_libs
}

# Match the upstream shared library name that applications load at
# runtime: DevDriverAPI-x64.dll on 64-bit Windows,
# libDevDriverAPI32.so on 32-bit Linux, and libDevDriverAPI.so on
# 64-bit Linux.
#
if ($windows && $cxx.target.cpu == 'x86_64')
  libs{DevDriverAPI}: bin.lib.load_suffix = '-x64'
elif (!$windows && $regex.match($cxx.target.cpu, 'i[3-6]86'))
  libs{DevDriverAPI}: bin.lib.load_suffix = '32'

# For pre-releases also use the complete version so they cannot be used
# in place of another pre-release or the final version. See the version
# module for details on the version.* variable values.
#
if $version.pre_release
  lib{DevDriverAPI}: bin.lib.version = "-$version.project_id"

# Don't install private headers.
#
{hxx ixx}{*}: install = false
