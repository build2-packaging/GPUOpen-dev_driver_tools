intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.
#import xxxx_libs += libhello%lib{hello}

lib{gpuopen-devdriverapi}: {hxx ixx cxx}{**} $impl_libs $intf_libs

# Build options.
#
out_pfx = [dir_path] $out_root/source/
src_pfx = [dir_path] $src_root/source/

cxx.poptions =+ "-I$out_pfx" "-I$src_pfx"

#obja{*}: cxx.poptions += -DLIBGPUOPEN_DEVDRIVERAPI_STATIC_BUILD
#objs{*}: cxx.poptions += -DLIBGPUOPEN_DEVDRIVERAPI_SHARED_BUILD

# Export options.
#
lib{gpuopen-devdriverapi}:
{
  cxx.export.poptions = "-I$out_pfx" "-I$src_pfx"
  cxx.export.libs = $intf_libs
}

#liba{gpuopen-devdriverapi}: cxx.export.poptions += -DLIBGPUOPEN_DEVDRIVERAPI_STATIC
#libs{gpuopen-devdriverapi}: cxx.export.poptions += -DLIBGPUOPEN_DEVDRIVERAPI_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{gpuopen-devdriverapi}: bin.lib.version = "-$version.project_id"
else
  lib{gpuopen-devdriverapi}: bin.lib.version = "-$version.major.$version.minor"

# Install recreating subdirectories.
#
{hxx ixx}{*}:
{
  install         = include/
  install.subdirs = true
}
